# Caddy 自动申请和续期 HTTPS 证书。CAT_DOMAIN / CAT_ALIASES 来自 .env。
{$CAT_DOMAIN} {$CAT_ALIASES:} {
	# 别名（比如 www.）统一跳到主域名：登录、通行密钥只认一个地址
	@alias not host {$CAT_DOMAIN}
	redir @alias https://{$CAT_DOMAIN}{uri} permanent

	encode zstd gzip
	# 不信任客户端自带的 X-Forwarded-*，由 Caddy 写入真实 IP
	reverse_proxy app:8737 {
		transport http {
			keepalive 60s
		}
	}
	header -Server
	request_body {
		max_size 1MB
	}
	log {
		output stdout
		format console
	}
}
