# Copy to keystore.properties (not committed) and fill in, then: ./gradlew bundleRelease
# Create the key once with:
#   keytool -genkeypair -v -keystore catnest-release.jks -alias catnest -keyalg RSA -keysize 2048 -validity 10000
# Keep the .jks file and these passwords safe: every update must be signed with the same key.
storeFile=catnest-release.jks
storePassword=
keyAlias=catnest
keyPassword=
