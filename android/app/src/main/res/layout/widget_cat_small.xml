<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_wall_day" android:clipToOutline="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="70" />
        <ImageView android:id="@+id/ground" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="30" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_floor" android:tint="#EBD3AE" />
    </LinearLayout>
<FrameLayout android:id="@+id/window" android:layout_width="46dp" android:layout_height="40dp" android:layout_gravity="top|end" android:layout_marginTop="11dp" android:layout_marginEnd="11dp">
        <ImageView android:id="@+id/window_sky" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:src="@drawable/widget_win_day" />
        <ImageView android:id="@+id/window_deco" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="8dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_deco_sun" />
        <ImageView android:id="@+id/window_frame" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:src="@drawable/widget_win_frame" />
    </FrameLayout>
<ImageView android:id="@+id/deco" android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="top|end" android:layout_marginTop="6dp" android:layout_marginEnd="6dp" android:contentDescription="@null" android:scaleType="fitCenter" android:visibility="gone" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="79" />
<ImageView android:id="@+id/cushion" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="16" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_cushion" android:layout_marginStart="22dp" android:layout_marginEnd="22dp"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="5" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="29" />
<ImageView android:id="@+id/cat" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="66" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_preview_cat"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="5" />
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_marginTop="12dp" android:layout_marginEnd="62dp" android:orientation="vertical">
    <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="汤圆" android:textColor="#4A3A34" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="心情不错" android:textColor="#AD4A3A34" android:textSize="11sp" android:layout_marginTop="2dp"/>
</LinearLayout>
<TextView android:id="@+id/letters" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_letters" android:drawablePadding="3dp" android:drawableStart="@drawable/widget_envelope" android:gravity="center_vertical" android:paddingStart="7dp" android:paddingTop="3dp" android:paddingEnd="7dp" android:paddingBottom="3dp" android:text="2" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" android:layout_gravity="top|end" android:layout_marginTop="10dp" android:layout_marginEnd="10dp"/>
</FrameLayout>
