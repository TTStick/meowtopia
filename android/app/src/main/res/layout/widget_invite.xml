<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_sky_day" android:clipToOutline="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="14dp">
    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="@null" android:src="@drawable/widget_paw" />
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="猫窝" android:textColor="#4A3A34" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="6dp"/>
    <TextView android:id="@+id/line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:maxLines="3" android:text="打开 App 登录后，这里会住进你的猫" android:textColor="#AD4A3A34" android:textSize="11sp" />
</LinearLayout>
</FrameLayout>
