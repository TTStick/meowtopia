<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_wall_day" android:clipToOutline="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="46">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="70" />
        <ImageView android:id="@+id/ground" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="30" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_floor" android:tint="#EBD3AE" />
    </LinearLayout>
        <FrameLayout android:id="@+id/window" android:layout_width="76dp" android:layout_height="66dp" android:layout_gravity="top|end" android:layout_marginTop="16dp" android:layout_marginEnd="16dp">
        <ImageView android:id="@+id/window_sky" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:src="@drawable/widget_win_day" />
        <ImageView android:id="@+id/window_deco" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="8dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_deco_sun" />
        <ImageView android:id="@+id/window_frame" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:src="@drawable/widget_win_frame" />
    </FrameLayout>
        <ImageView android:id="@+id/deco" android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="top|end" android:layout_marginTop="10dp" android:layout_marginEnd="14dp" android:contentDescription="@null" android:scaleType="fitCenter" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="58">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="80" />
<ImageView android:id="@+id/cushion" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="15" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_cushion" android:layout_marginStart="26dp" android:layout_marginEnd="26dp"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="5" />
</LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="17" />
<ImageView android:id="@+id/cat" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="78" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_preview_cat"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="5" />
</LinearLayout>
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="42">
                <TextView android:id="@+id/bubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_marginEnd="12dp" android:layout_marginBottom="32dp" android:background="@drawable/widget_bubble" android:maxLines="2" android:ellipsize="end" android:paddingStart="10dp" android:paddingTop="7dp" android:paddingEnd="10dp" android:paddingBottom="7dp" android:text="想玩逗猫棒" android:textColor="#4A3A34" android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="54" android:background="@drawable/widget_panel_light" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="15dp" android:paddingEnd="15dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="汤圆" android:textColor="#4A3A34" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="第 12 天" android:textColor="#AD4A3A34" android:textSize="10.5sp" android:layout_marginStart="6dp"/>
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/letters" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_letters" android:drawablePadding="3dp" android:drawableStart="@drawable/widget_envelope" android:gravity="center_vertical" android:paddingStart="7dp" android:paddingTop="3dp" android:paddingEnd="7dp" android:paddingBottom="3dp" android:text="2" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="心情不错" android:textColor="#AD4A3A34" android:textSize="13sp" android:layout_marginTop="2dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="9dp">
            <TextView android:id="@+id/food_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="饱腹" android:textColor="#AD4A3A34" android:textSize="10.5sp" />
            <ProgressBar android:id="@+id/food" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_marginStart="5dp" android:layout_weight="1" android:max="100" android:progress="72" android:progressDrawable="@drawable/widget_bar_food" />
        </LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="5dp">
            <TextView android:id="@+id/energy_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="精神" android:textColor="#AD4A3A34" android:textSize="10.5sp" />
            <ProgressBar android:id="@+id/energy" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_marginStart="5dp" android:layout_weight="1" android:max="100" android:progress="72" android:progressDrawable="@drawable/widget_bar_energy" />
        </LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="5dp">
            <TextView android:id="@+id/mood_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="心情" android:textColor="#AD4A3A34" android:textSize="10.5sp" />
            <ProgressBar android:id="@+id/mood" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_marginStart="5dp" android:layout_weight="1" android:max="100" android:progress="72" android:progressDrawable="@drawable/widget_bar_mood" />
        </LinearLayout>
        <TextView android:id="@+id/extra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="今天的心愿 1/3" android:textColor="#4A3A34" android:textSize="11.5sp" android:textStyle="bold" android:layout_marginTop="10dp"/>
        <TextView android:id="@+id/town" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="今晚 19:30 小镇乐团" android:textColor="#AD4A3A34" android:textSize="11.5sp" android:layout_marginTop="3dp"/>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
