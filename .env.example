# Copy to .env and fill in. Everything is optional — the game runs without any of it.

# Claude API key: cats' speech, conversations, diaries and text commands are
# generated by Claude. Without a key, a built-in procedural generator is used.
ANTHROPIC_API_KEY=

# Model used for cat language (default: claude-opus-5-5).
# claude-haiku-5-5 is much cheaper and plenty for short cute lines.
# CAT_LLM_MODEL=claude-opus-5-5

# Optional API base URL (e.g. a proxy). Defaults to https://api.anthropic.com
# CAT_LLM_BASE_URL=

# Rate limits for model calls (per minute / per day, whole server)
# CAT_LLM_RPM=40
# CAT_LLM_DAILY=4000

# Web Push contact (required by the push protocol; use your own email or site)
# CAT_VAPID_SUBJECT=mailto:you@example.com

# The shared town's clock, in hours from UTC (default: this server's timezone).
# Set to 8 if most players are in China.
# CAT_WORLD_TZ=8

# Server port and database file
# PORT=8737
# CAT_DB=data/cats.db
