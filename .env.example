# 复制为 .env 后按需填写。除了部署时的 CAT_DOMAIN，其余都可以不填。

# ---------- 部署 ----------
# 你的域名（已解析到服务器 IP）。Caddy 会自动申请 HTTPS 证书。
CAT_DOMAIN=cat.example.com

# 其他也解析到这台服务器的域名（多个用空格隔开），访问时会跳转到上面的主域名。
# 例如 www.cat.example.com。不需要就留空。
CAT_ALIASES=

# 管理员口令：用于 scripts/admin.mjs 处理举报、封禁。留空则管理接口关闭。
# 生成：openssl rand -hex 24
CAT_ADMIN_TOKEN=

# 小镇的统一时钟（相对 UTC 的小时数）。面向国内玩家设为 8。
CAT_WORLD_TZ=8

# 构建镜像时用的 npm 源。国内服务器下载慢可以改成 https://registry.npmmirror.com
# NPM_REGISTRY=https://registry.npmjs.org

# ---------- Claude 猫语（可选）----------
# 填了 key，猫猫说的话、对话、日记和文字指令由 Claude 生成；不填则用内置生成器。
# 这一组也可以在管理面板（https://你的域名/admin/ →「模型」）里填写和修改，面板里的设置优先。
ANTHROPIC_API_KEY=
# 默认 claude-opus-5-5；想省钱可换 claude-haiku-5-5
# CAT_LLM_MODEL=claude-opus-5-5
# 兼容 Anthropic API 的其他服务（比如 MiniMax）：模型填它的模型 ID，这里填它的接口地址
# CAT_LLM_BASE_URL=
# 全服限速（每分钟 / 每天）与每位玩家每天的额度，超出后自动用内置猫语
# CAT_LLM_RPM=40
# CAT_LLM_DAILY=4000
# CAT_LLM_USER_DAILY=120

# ---------- 推送 ----------
# Web Push 协议要求的联系方式（你的网站或邮箱）
# CAT_VAPID_SUBJECT=https://cat.example.com

# iOS App 的推送（APNs）。在 Apple 开发者后台创建 .p8 密钥后填写，
# 并在 docker-compose.yml 里挂载密钥文件。
# CAT_APNS_KEY_ID=
# CAT_APNS_TEAM_ID=
# CAT_APNS_BUNDLE_ID=com.catnest.app
# CAT_APNS_KEY_FILE=/app/secrets/AuthKey.p8

# ---------- 安全与容量（一般不用改）----------
# 每个 IP 每小时最多新建几个游客账号
# CAT_REGISTER_PER_HOUR=6
# 登录有效期（天，期间常来会自动续期）
# CAT_SESSION_DAYS=180
# 同时在线连接上限、每个 IP 的连接上限
# CAT_MAX_CONNECTIONS=3000
# CAT_MAX_CONNECTIONS_PER_IP=30
# 小镇里同时自主闲逛的玩家猫上限
# CAT_MAX_WANDERERS=60
# 额外允许的来源（例如以后的 App：capacitor://localhost），逗号分隔
# CAT_ORIGINS=
# 通行密钥绑定的域名，默认就是访问的域名
# CAT_RP_ID=
# 只在直接暴露在公网、前面没有反向代理时设为 none
# CAT_TRUST_PROXY=private
# 每日自动备份（data/backups，保留 7 天），设为 off 关闭
# CAT_BACKUPS=on

# ---------- 本地开发 ----------
# PORT=8737
# CAT_DATA_DIR=data
